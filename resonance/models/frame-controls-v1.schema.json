{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Harmony source-frame controls v1",
 "type":"object",
 "additionalProperties":false,
 "required":["schema","clock_id","sample_rate_hz","frame_hop_samples","available_through_sample","frame_center_samples","observation_end_samples","target_f0_hz","gain_multiplier"],
 "properties":{
  "schema":{"const":"harmony-frame-controls/v1"},
  "clock_id":{"type":"string","minLength":1,"maxLength":128},
  "sample_rate_hz":{"const":44100},
  "frame_hop_samples":{"const":512},
  "available_through_sample":{"type":"integer","minimum":0,"maximum":9007199254740991,"multipleOf":512},
  "frame_center_samples":{"type":"array","minItems":1,"maxItems":8192,"items":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},
  "observation_end_samples":{"type":"array","minItems":1,"maxItems":8192,"items":{"type":"integer","minimum":0,"maximum":9007199254740991,"multipleOf":512}},
  "target_f0_hz":{"type":"array","minItems":1,"maxItems":8192,"items":{"anyOf":[{"const":0},{"type":"number","minimum":50,"maximum":2500}]}},
  "gain_multiplier":{"type":"array","minItems":1,"maxItems":8192,"items":{"type":"number","minimum":0,"maximum":1}}
 },
 "description":"Runtime validation must additionally enforce equal array lengths, source centers on 256+k*512, observation_end=max(0,center+256)<=available_through, matching capture epoch, and zero pitch/gain for negative pre-stream centers. JSON cannot encode NaN or Infinity. See docs/CONTROL_CONTRACT.md."
}
